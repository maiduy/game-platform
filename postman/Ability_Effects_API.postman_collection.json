            "body": {
              "mode": "raw",
              "raw": "{\n  \"effectId\": \"effect_fireball_dot\",\n  \"category\": \"DamageOverTime\",\n  \"name\": \"Fireball Burn\",\n  \"order\": 100,\n  \"effectType\": \"GenericEffect\",\n  \"durationPolicy\": 1,\n  \"duration\": 5.0,\n  \"interval\": 1.0,\n  \"stacks\": 3,\n  \"tags\": [\"fire\", \"dot\", \"magical\"],\n  \"modifiers\": [\n    {\n      \"name\": \"Attack\",\n      \"flat\": 50.0,\n      \"percent\": 0.0\n    }\n  ],\n  \"metadata\": {\n    \"vfx\": \"vfx_burning_loop\",\n    \"sfx\": \"sfx_fire_burn\",\n    \"tagsToApply\": [\"Burn\"]\n  }\n}"
